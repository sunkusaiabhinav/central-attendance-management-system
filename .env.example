# ─── Database ───────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/attendance_db

# ─── JWT Authentication ──────────────────────────────────────────────────────
# A long, random secret used to sign JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
# Token lifetime in minutes (default 30 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Company / Policy Settings ───────────────────────────────────────────────
# Timezone string as found in the IANA tz database (e.g. Asia/Kolkata, UTC)
COMPANY_TIMEZONE=Asia/Kolkata
# Minimum physical office days required per week
MIN_OFFICE_DAYS_PER_WEEK=3
# Minimum total working hours required per week (decimal hours)
MIN_WEEKLY_WORKING_HOURS=15
# Minimum average working hours per qualifying attendance day (decimal hours)
MIN_AVERAGE_HOURS_PER_DAY=5

# ─── SMTP / Email ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
# Set to "true" to use a mock email backend (no real emails sent)
EMAIL_MOCK_MODE=false

# ─── Compliance Scheduler ────────────────────────────────────────────────────
# Day of the week to evaluate the previous completed week.
# Values: monday, tuesday, wednesday, thursday, friday, saturday, sunday
ATTENDANCE_EVALUATION_DAY=monday
# 24-hour time to run the weekly evaluation job (HH:MM)
ATTENDANCE_EVALUATION_TIME=09:00
